# Only needed when deploying somewhere reachable off your own machine
# (see deploy/README.md). Leave all four blank/unset for local use --
# the app runs with no login at all when GOOGLE_CLIENT_ID is unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=
FLASK_SECRET_KEY=
